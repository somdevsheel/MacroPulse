# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL) ---
# Local server on this machine listens on port 5433.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/macropulse

# --- Data lake root (bronze/silver/gold Parquet) ---
DATA_DIR=./data

# --- Economic / macro providers ---
FRED_API_KEY=
# Optional, paid. Leave empty -> provider is reported as "disconnected".
TRADING_ECONOMICS_API_KEY=
BLS_API_KEY=
BEA_API_KEY=

# --- Market data providers ---
# OANDA practice or live token (read-only use: historical candles).
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice
TWELVE_DATA_API_KEY=

# --- App ---
LOG_LEVEL=INFO
LOG_JSON=false
